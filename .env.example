# Copie para .env.local e preencha no servidor. Todos os valores abaixo são fictícios.
# Para uma prévia local, prefira npm run setup:local.
PORTFOLIO_MODE=supabase
PORTFOLIO_LOCAL_PREVIEW=false
# Configuração pública, não marcar como segredo na hospedagem.
PORTFOLIO_PUBLIC_ORIGIN=https://portfolio.example.com
# PORTFOLIO_SITE_ORIGIN continua aceito para ambientes existentes.

# URL e chaves do projeto Supabase existente.
# Todas ficam no servidor; NÃO use prefixo NEXT_PUBLIC_ nestas chaves.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=chave-publicavel-ficticia
SUPABASE_SECRET_KEY=chave-secreta-ficticia

# Só habilite quando seu proxy substitui e protege X-Forwarded-For.
PORTFOLIO_TRUST_PROXY=false

# Exclusivo do modo local, recusado com NODE_ENV=production:
PORTFOLIO_DATA_DIR=.local-data

# FAQ opcional: sem a chave, o site usa respostas cadastradas.
# A chave fica no servidor e nunca recebe prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=chave-openai-ficticia
JORAK_FAQ_MODEL=gpt-4.1-mini
